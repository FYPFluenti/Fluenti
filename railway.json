{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server/python && chmod +x build.sh && ./build.sh"
  },
  "deploy": {
    "startCommand": "cd server/python && python therapy_service.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

