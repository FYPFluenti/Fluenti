# Database Configuration
# MongoDB Connection String (currently used)
MONGODB_URI=mongodb://localhost:27017/fluenti

# OpenAI API Key
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face (Free token from huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your-hf-token

# Session Secret (generate a secure random string)
SESSION_SECRET=your_very_long_random_session_secret_here_at_least_64_characters

# Application Port
PORT=3001

# Node Environment
NODE_ENV=development

# Speech Therapy & Games Configuration
# Speech API key for speech recognition services
NEXT_PUBLIC_SPEECH_API_KEY=your_speech_api_key_here

# Clinical API key for therapeutic data and tracking
NEXT_PUBLIC_CLINICAL_API_KEY=your_clinical_api_key_here

# Articulation Station API key for pronunciation games
NEXT_PUBLIC_ARTICULATION_API_KEY=your_articulation_station_key

# Enable/disable speech recognition features
NEXT_PUBLIC_ENABLE_SPEECH_RECOGNITION=true

# Application environment
NEXT_PUBLIC_APP_ENV=development

# Vite equivalents (since we're using Vite, not Next.js)
# Access these in your code with import.meta.env.VITE_*
VITE_SPEECH_API_KEY=your_speech_api_key_here
VITE_CLINICAL_API_KEY=your_clinical_api_key_here
VITE_ARTICULATION_API_KEY=your_articulation_station_key
VITE_ENABLE_SPEECH_RECOGNITION=true
VITE_APP_ENV=development
