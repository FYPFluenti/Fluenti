# API Keys for Emotional Therapy Bot
# Copy this file to .env and add your actual API keys

# Required: Groq API Key for LLM chat completions
# Get your free key from: https://console.groq.com/
GROQ_API_KEY=gsk_YOUR_API_KEY_HERE

# Required: OpenAI API Key for embeddings (extremely cost-effective)
# Get your key from: https://platform.openai.com/api-keys
# Cost: $0.02 per 1M tokens with text-embedding-3-small
OPENAI_API_KEY=sk-YOUR_API_KEY_HERE

# Optional: Encryption settings for enhanced security
ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_SALT=therapy_bot_salt

# Optional: Database settings
MONGODB_URI=mongodb://localhost:27017/therapy_bot

# Optional: Rate limiting and security
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Optional: Knowledge base processing limits
KB_PROCESS_LIMIT=2000

# Optional: Audit logging
AUDIT_LOG_FILE=therapy_audit.log

# Development settings
DEBUG=False
ENVIRONMENT=production